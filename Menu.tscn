[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Menu.gd" id="1_menu"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.05, 0.15, 1)

[node name="Title" type="Label" parent="."]
layout_mode = 0
offset_left = 80.0
offset_top = 60.0
offset_right = 800.0
offset_bottom = 200.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 90
text = "DELTVA IV"

[node name="Subtitle" type="Label" parent="."]
layout_mode = 0
offset_left = 85.0
offset_top = 180.0
offset_right = 800.0
offset_bottom = 220.0
theme_override_colors/font_color = Color(1, 0.2, 0.8, 1)
theme_override_font_sizes/font_size = 28
text = "BIGGER. BOLDER. MORE REALISTIC."

[node name="MainButtons" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 80.0
offset_top = 260.0
offset_right = 450.0
offset_bottom = 700.0
theme_override_constants/separation = 10

[node name="NewGame" type="Button" parent="MainButtons"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "NEW GAME"
alignment = 0

[node name="Continue" type="Button" parent="MainButtons"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "CONTINUE"
alignment = 0

[node name="CharSelect" type="Button" parent="MainButtons"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "CHARACTER SELECT"
alignment = 0

[node name="Settings" type="Button" parent="MainButtons"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "SETTINGS"
alignment = 0

[node name="Online" type="Button" parent="MainButtons"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "ONLINE"
alignment = 0

[node name="Exit" type="Button" parent="MainButtons"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "EXIT GAME"
alignment = 0

[node name="CharacterSelect" type="GridContainer" parent="."]
layout_mode = 0
offset_left = 550.0
offset_top = 200.0
offset_right = 1200.0
offset_bottom = 700.0
columns = 2
theme_override_constants/h_separation = 20
theme_override_constants/v_separation = 20

[node name="Char1" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 1"

[node name="Char2" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 2"

[node name="Char3" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 3"

[node name="Char4" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 4"

[node name="Char5" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 5"

[node name="Char6" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 6"

[node name="Char7" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 7"

[node name="Char8" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 8"

[node name="Char9" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 9"

[node name="Char10" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KARAKTER 10"

[node name="BackBtn" type="Button" parent="CharacterSelect"]
layout_mode = 2
text = "KEMBALI"

[node name="PopupPanel" type="AcceptDialog" parent="."]

[connection signal="pressed" from="MainButtons/NewGame" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="MainButtons/CharSelect" to="." method="_on_character_select_pressed"]
[connection signal="pressed" from="MainButtons/Online" to="." method="_on_online_pressed"]
[connection signal="pressed" from="MainButtons/Exit" to="." method="_on_exit_pressed"]
[connection signal="pressed" from="CharacterSelect/BackBtn" to="." method="_on_back_pressed"]
[connection signal="pressed" from="CharacterSelect/Char1" to="." method="_on_char_selected" binds= [0]]
[connection signal="pressed" from="CharacterSelect/Char2" to="." method="_on_char_selected" binds= [1]]
[connection signal="pressed" from="CharacterSelect/Char3" to="." method="_on_char_selected" binds= [2]]
[connection signal="pressed" from="CharacterSelect/Char4" to="." method="_on_char_selected" binds= [3]]
[connection signal="pressed" from="CharacterSelect/Char5" to="." method="_on_char_selected" binds= [4]]
[connection signal="pressed" from="CharacterSelect/Char6" to="." method="_on_char_selected" binds= [5]]
[connection signal="pressed" from="CharacterSelect/Char7" to="." method="_on_char_selected" binds= [6]]
[connection signal="pressed" from="CharacterSelect/Char8" to="." method="_on_char_selected" binds= [7]]
[connection signal="pressed" from="CharacterSelect/Char9" to="." method="_on_char_selected" binds= [8]]
[connection signal="pressed" from="CharacterSelect/Char10" to="." method="_on_char_selected" binds= [9]]
