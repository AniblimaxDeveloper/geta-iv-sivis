[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://Menu.gd" id="1_menu"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.02, 0.1, 1)

[node name="Title" type="Label" parent="."]
layout_mode = 0
offset_left = 80.0
offset_top = 60.0
offset_right = 800.0
offset_bottom = 200.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 90
text = "DELTVA IV"

[node name="Subtitle" type="Label" parent="."]
layout_mode = 0
offset_left = 85.0
offset_top = 180.0
offset_right = 800.0
offset_bottom = 220.0
theme_override_colors/font_color = Color(1, 0.2, 0.8, 1)
theme_override_font_sizes/font_size = 28
text = "BIGGER. BOLDER. MORE REALISTIC."

[node name="MainButtons" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 80.0
offset_top = 280.0
offset_right = 450.0
offset_bottom = 700.0
theme_override_constants/separation = 15

[node name="NewGame" type="Button" parent="MainButtons"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_font_sizes/font_size = 32
text = "NEW GAME"
alignment = 0

[node name="Continue" type="Button" parent="MainButtons"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_font_sizes/font_size = 32
text = "CONTINUE"
alignment = 0

[node name="CharSelect" type="Button" parent="MainButtons"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_font_sizes/font_size = 32
text = "CHARACTER SELECT"
alignment = 0

[node name="Settings" type="Button" parent="MainButtons"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_font_sizes/font_size = 32
text = "SETTINGS"
alignment = 0

[node name="Online" type="Button" parent="MainButtons"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_font_sizes/font_size = 32
text = "ONLINE"
alignment = 0

[node name="Exit" type="Button" parent="MainButtons"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_font_sizes/font_size = 32
text = "EXIT GAME"
alignment = 0

[node name="ProfilePanel" type="ColorRect" parent="."]
layout_mode = 0
offset_left = 850.0
offset_top = 60.0
offset_right = 1200.0
offset_bottom = 220.0
color = Color(0, 0, 0, 0.6)

[node name="Avatar" type="ColorRect" parent="ProfilePanel"]
layout_mode = 0
offset_left = 20.0
offset_top = 20.0
offset_right = 120.0
offset_bottom = 120.0
color = Color(0.2, 0.6, 1, 1)

[node name="NameLabel" type="Label" parent="ProfilePanel"]
layout_mode = 0
offset_left = 140.0
offset_top = 20.0
offset_right = 330.0
offset_bottom = 60.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 28
text = "Player_Name"

[node name="LevelLabel" type="Label" parent="ProfilePanel"]
layout_mode = 0
offset_left = 140.0
offset_top = 60.0
offset_right = 330.0
offset_bottom = 90.0
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 20
text = "LEVEL 1"

[node name="MoneyLabel" type="Label" parent="ProfilePanel"]
layout_mode = 0
offset_left = 140.0
offset_top = 95.0
offset_right = 330.0
offset_bottom = 130.0
theme_override_colors/font_color = Color(0.2, 1, 0.4, 1)
theme_override_font_sizes/font_size = 24
text = "$0"

[node name="Popup" type="ColorRect" parent="."]
visible = false
layout_mode = 0
offset_left = 400.0
offset_top = 300.0
offset_right = 880.0
offset_bottom = 420.0
color = Color(0, 0, 0, 0.9)

[node name="Label" type="Label" parent="Popup"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 24
text = "SETTINGS"
horizontal_alignment = 1
vertical_alignment = 1

[connection signal="pressed" from="MainButtons/NewGame" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="MainButtons/Settings" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="MainButtons/Online" to="." method="_on_online_pressed"]
[connection signal="pressed" from="MainButtons/Exit" to="." method="_on_quit_pressed"]
