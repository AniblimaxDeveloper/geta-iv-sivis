[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://Menu.gd" id="1_menu"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.02, 0.1, 1)

[node name="MainUI" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Title" type="Label" parent="MainUI"]
layout_mode = 0
offset_left = 80.0
offset_top = 60.0
offset_right = 800.0
offset_bottom = 200.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 90
text = "DELTVA IV"

[node name="VBox" type="VBoxContainer" parent="MainUI"]
layout_mode = 0
offset_left = 80.0
offset_top = 280.0
offset_right = 450.0
offset_bottom = 700.0
theme_override_constants/separation = 15

[node name="PlayBtn" type="Button" parent="MainUI/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
text = "NEW GAME"

[node name="CharBtn" type="Button" parent="MainUI/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
text = "CHARACTER SELECT"

[node name="SettingsBtn" type="Button" parent="MainUI/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
text = "SETTINGS"

[node name="ExitBtn" type="Button" parent="MainUI/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
text = "EXIT"

[node name="SettingsUI" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Label" type="Label" parent="SettingsUI"]
layout_mode = 0
offset_left = 100.0
offset_top = 100.0
offset_right = 500.0
offset_bottom = 150.0
theme_override_font_sizes/font_size = 48
text = "SETTINGS"

[node name="BackBtn" type="Button" parent="SettingsUI"]
layout_mode = 0
offset_left = 100.0
offset_top = 600.0
offset_right = 300.0
offset_bottom = 650.0
text = "KEMBALI"

[node name="CharSelectUI" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Label" type="Label" parent="CharSelectUI"]
layout_mode = 0
offset_left = 100.0
offset_top = 100.0
offset_right = 800.0
offset_bottom = 150.0
theme_override_font_sizes/font_size = 48
text = "PILIH KARAKTER (1-10)"

[node name="StatusLabel" type="Label" parent="CharSelectUI"]
layout_mode = 0
offset_left = 100.0
offset_top = 200.0
offset_right = 800.0
offset_bottom = 250.0
theme_override_colors/font_color = Color(0.2, 1, 0.4, 1)
theme_override_font_sizes/font_size = 32
text = "Belum ada karakter dipilih"

[node name="BackBtn" type="Button" parent="CharSelectUI"]
layout_mode = 0
offset_left = 100.0
offset_top = 600.0
offset_right = 300.0
offset_bottom = 650.0
text = "KEMBALI"

[connection signal="pressed" from="MainUI/VBox/PlayBtn" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="MainUI/VBox/CharBtn" to="." method="_on_char_select_pressed"]
[connection signal="pressed" from="MainUI/VBox/SettingsBtn" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="MainUI/VBox/ExitBtn" to="." method="_on_exit_pressed"]
[connection signal="pressed" from="SettingsUI/BackBtn" to="." method="_on_back_pressed"]
[connection signal="pressed" from="CharSelectUI/BackBtn" to="." method="_on_back_pressed"]
